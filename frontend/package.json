{
  "name": "viticontrol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:demo": "ng build --configuration demo",
    "serve:demo": "ng serve --configuration demo --host 127.0.0.1 --port 4300",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"playwright*.ts\"",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "lucide-angular": "1.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@playwright/test": "^1.51.1",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2"
  }
}
