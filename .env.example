# Usa contraseñas diferentes. Para POSTGRES_PASSWORD usa caracteres alfanuméricos
# (o codifica los caracteres especiales si construyes la URL de conexión).
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_TAMBIEN
# false para http://localhost; true al publicar con HTTPS.
COOKIE_SECURE=false
# true solo si deseas importar los datos ficticios en una base vacía.
SEED_DEMO=false
